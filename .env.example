# tech7fax environment variables
# Copy to .env.local and fill in values.

# API endpoint (default: YOUR_FAX_ENDPOINT_HERE)
VITE_FAX_ENDPOINT=YOUR_FAX_ENDPOINT_HERE

# Optional API key — sent as Bearer token in Authorization header
VITE_FAX_API_KEY=

# Site password gate. Leave empty to disable the gate.
# NOTE: client-side only — bypassable by anyone reading the JS bundle.
VITE_SITE_PASSWORD=
