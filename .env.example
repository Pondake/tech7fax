# tech7fax environment variables
# Copy to .env and fill in values. In production, set these in the Vercel project
# settings. All of them are server-only: none may get a VITE_ prefix, or Vite would
# bake it into the public JS bundle.

# Fax API base URL; the app posts to ${FAX_ENDPOINT}/html (required)
FAX_ENDPOINT=

# Bearer token for the fax API (optional)
FAX_API_KEY=

# Sender name shown on the outgoing fax (required by the API)
FAX_SENDER=

# Login password, checked server-side. At least 12 characters; logins are refused otherwise.
SITE_PASSWORD=

# Signs the session cookie. At least 32 random characters, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Changing it logs everyone out.
SESSION_SECRET=

# Shared rate limit store (Upstash Redis via the Vercel Marketplace). Optional, but without
# it the limits only apply per function instance. Either pair works.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Optional limits (defaults shown)
# MAX_BODY_BYTES=4000000
# MAX_IMAGES=10
# SENDS_PER_SESSION_PER_HOUR=10
# SENDS_PER_IP_PER_HOUR=10
# SENDS_PER_DAY=30
# LOGIN_ATTEMPTS_PER_IP=10
# UPSTREAM_TIMEOUT_MS=25000

# Extra origins allowed to call the API, comma-separated (optional; same-origin always works)
# ALLOWED_ORIGINS=
